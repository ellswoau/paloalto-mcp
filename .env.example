# Copy to .env and fill in. NEVER commit the password or token.
PALO_USERNAME=aeadmin
PALO_PASSWORD=
# Management IP template; {store} is the store number (third octet).
PALO_IP_TEMPLATE=10.102.{store}.250
PALO_SSH_PORT=22
PALO_TIMEOUT=60
PALO_CONNECT_TIMEOUT=15
# Answer to the "Do you accept and acknowledge the statement above ?" prompt.
PALO_STATEMENT_RESPONSE=yes
# Send `set cli pager off` after login (per-session on PAN-OS).
PALO_PAGER_OFF=true
# Host-key checking. Leave strict off to auto-accept on first use, or point at
# a known_hosts file and set strict on.
PALO_STRICT_HOST_KEY=false
# PALO_KNOWN_HOSTS=/etc/ssh/ssh_known_hosts
# Bearer token that gates the network MCP endpoints (empty = auth disabled).
# Generate with: openssl rand -hex 32
PALO_MCP_AUTH_TOKEN=
# PALO_CONFIG_FILE=./palo.json